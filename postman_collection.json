            "url": {
              "raw": "{{base_url}}/rest/v1/ticket_comments?ticket_id=eq.{{ticket_id}}&select=*,user:profiles(id,name,role)&order=created_at.asc",
              "host": ["{{base_url}}"],
              "path": ["rest", "v1", "ticket_comments"],
              "query": [
                {
                  "key": "ticket_id",
