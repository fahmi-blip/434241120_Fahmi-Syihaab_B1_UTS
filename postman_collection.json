                {
                  "key": "select",
                  "value": "*,user:profiles(id,name,role)"
                },
                {
                  "key": "order",
                  "value": "created_at.asc"
                }
              ]
            },
            "description": "Ambil semua komentar untuk ticket"
          },
          "response": []
        }
      ]
    }
